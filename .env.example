# Application
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
PORT=5000

# Database
DATABASE_URL=sqlite:///instance/app.db
# Production example: postgresql://user:password@localhost:5432/recruitment_db

# File uploads
UPLOAD_FOLDER=instance/uploads

# Demo users (development only)
SEED_DEMO_USERS=true

# Mail (optional - leave blank to disable email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@yourapp.com

# Google Gemini (CV scoring + feedback; rule-based fallback when unset)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq LLM (legacy — no longer used for CV scoring)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
